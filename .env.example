PORT=3001
FRONTEND_URL=http://127.0.0.1:5173

# Destinatários confiáveis do servidor, separados por vírgula: uma mensagem com ambos em To.
QUOTE_EMAIL_TO=fernando403@gmail.com,globalfer_marilia@yahoo.com.br
# Configure estes dados com o provedor do e-mail remetente.
# Para Gmail, normalmente é preciso usar uma senha de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM="Site Globalfer <seu-email@gmail.com>"

# Optional staff notifications through the official Meta Cloud API. Disabled by default.
# Server-side only: never use VITE_* variables or put a production token in this file.
# Complete docs/whatsapp-notifications.md before enabling; placeholders cannot send.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-sender-phone-number-id
# Staff recipient in +E.164 format; do not reuse the sender number or customer phone.
WHATSAPP_TO=replace-with-authorized-staff-recipient-in-plus-E164-format
# Proposed template/language only: use the exact values approved for your WABA.
WHATSAPP_TEMPLATE_NAME=globalfer_new_quote
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_ACCESS_TOKEN=replace-with-development-token
